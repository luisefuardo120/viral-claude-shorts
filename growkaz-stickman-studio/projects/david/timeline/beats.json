[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 4.6,
  "text": "Un joven con una sola piedra derribó a un gigante de casi tres metros.",
  "end": 4.93
 },
 {
  "i": 1,
  "start": 4.93,
  "speechStart": 5.08,
  "speechEnd": 7.26,
  "text": "El gigante se llamaba Goliat.",
  "end": 7.11
 },
 {
  "i": 2,
  "start": 7.11,
  "speechStart": 7.26,
  "speechEnd": 12.86,
  "text": "Durante cuarenta días desafió al ejército de Israel, y nadie se atrevía a enfrentarlo.",
  "end": 13.03
 },
 {
  "i": 3,
  "start": 13.03,
  "speechStart": 13.18,
  "speechEnd": 17.92,
  "text": "Hasta que llegó David, un joven pastor que solo traía comida para sus hermanos.",
  "end": 18.19
 },
 {
  "i": 4,
  "start": 18.19,
  "speechStart": 18.34,
  "speechEnd": 21.14,
  "text": "Le ofrecieron una armadura, pero le quedaba enorme.",
  "end": 21.55
 },
 {
  "i": 5,
  "start": 21.55,
  "speechStart": 21.7,
  "speechEnd": 25.34,
  "text": "Así que tomó su honda y cinco piedras lisas del arroyo.",
  "end": 25.19
 },
 {
  "i": 6,
  "start": 25.19,
  "speechStart": 25.34,
  "speechEnd": 27.52,
  "text": "Goliat se burló de él.",
  "end": 27.37
 },
 {
  "i": 7,
  "start": 27.37,
  "speechStart": 27.52,
  "speechEnd": 29.06,
  "text": "Pero David le dijo:",
  "end": 29.37
 },
 {
  "i": 8,
  "start": 29.37,
  "speechStart": 29.52,
  "speechEnd": 31.08,
  "text": "\"Tú vienes a mí con espada…",
  "end": 31.25
 },
 {
  "i": 9,
  "start": 31.25,
  "speechStart": 31.4,
  "speechEnd": 34.02,
  "text": "mas yo vengo a ti en el nombre de Jehová.\"",
  "end": 34.31
 },
 {
  "i": 10,
  "start": 34.31,
  "speechStart": 34.46,
  "speechEnd": 35.94,
  "text": "Lanzó una sola piedra…",
  "end": 35.79
 },
 {
  "i": 11,
  "start": 35.79,
  "speechStart": 35.94,
  "speechEnd": 37.42,
  "text": "y el gigante cayó.",
  "end": 37.83
 },
 {
  "i": 12,
  "start": 37.83,
  "speechStart": 37.98,
  "speechEnd": 41.86,
  "text": "Tu gigante puede ser enorme, pero tu Dios es más grande.",
  "end": 42.35
 },
 {
  "i": 13,
  "start": 42.35,
  "speechStart": 42.5,
  "speechEnd": 44.62,
  "text": "Sígueme para la próxima historia.",
  "end": 46.12
 }
]