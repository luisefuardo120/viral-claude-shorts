[
 {
  "i": 0,
  "start": 0.0,
  "speechStart": 0.0,
  "speechEnd": 4.34,
  "text": "Este hombre pasó tres días dentro de un pez… y sobrevivió.",
  "end": 4.61
 },
 {
  "i": 1,
  "start": 4.61,
  "speechStart": 4.76,
  "speechEnd": 6.54,
  "text": "Se llamaba Jonás.",
  "end": 6.39
 },
 {
  "i": 2,
  "start": 6.39,
  "speechStart": 6.54,
  "speechEnd": 10.26,
  "text": "Dios le pidió que fuera a la ciudad de Nínive a dar un mensaje,",
  "end": 10.45
 },
 {
  "i": 3,
  "start": 10.45,
  "speechStart": 10.6,
  "speechEnd": 15.04,
  "text": "pero él tuvo miedo y huyó en un barco, justo hacia el lado contrario.",
  "end": 15.51
 },
 {
  "i": 4,
  "start": 15.51,
  "speechStart": 15.66,
  "speechEnd": 20.92,
  "text": "Entonces vino una tormenta tan fuerte que los marineros pensaron que iban a morir.",
  "end": 20.77
 },
 {
  "i": 5,
  "start": 20.77,
  "speechStart": 20.92,
  "speechEnd": 26.84,
  "text": "Jonás sabía que era por su culpa, así que les pidió que lo lanzaran al mar.",
  "end": 27.13
 },
 {
  "i": 6,
  "start": 27.13,
  "speechStart": 27.28,
  "speechEnd": 30.58,
  "text": "Y en ese momento, un gran pez se lo tragó.",
  "end": 30.43
 },
 {
  "i": 7,
  "start": 30.43,
  "speechStart": 30.58,
  "speechEnd": 33.36,
  "text": "Allí, en la oscuridad, Jonás oró…",
  "end": 33.21
 },
 {
  "i": 8,
  "start": 33.21,
  "speechStart": 33.36,
  "speechEnd": 35.08,
  "text": "y Dios lo escuchó.",
  "end": 35.39
 },
 {
  "i": 9,
  "start": 35.39,
  "speechStart": 35.54,
  "speechEnd": 38.66,
  "text": "Al tercer día, el pez lo dejó en tierra firme.",
  "end": 38.97
 },
 {
  "i": 10,
  "start": 38.97,
  "speechStart": 39.12,
  "speechEnd": 40.6,
  "text": "Porque puedes huir de Dios…",
  "end": 40.85
 },
 {
  "i": 11,
  "start": 40.85,
  "speechStart": 41.0,
  "speechEnd": 42.72,
  "text": "pero Dios nunca huye de ti.",
  "end": 43.09
 },
 {
  "i": 12,
  "start": 43.09,
  "speechStart": 43.24,
  "speechEnd": 45.38,
  "text": "Sígueme para la próxima historia.",
  "end": 46.88
 }
]