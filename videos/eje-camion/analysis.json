{
 "duration": 44.722,
 "phrases": [
  {
   "n": 1,
   "t0": 0,
   "t1": 2.9,
   "from": 0,
   "to": 10,
   "text": "Porque algunos camiones van con ruedas que no tocan el suelo?",
   "question": true
  },
  {
   "n": 2,
   "t0": 3.14,
   "t1": 8.4,
   "from": 11,
   "to": 25,
   "text": "Un camión cargado pesa tanto que, si apoyara todo en pocas ruedas, destrozaría la carretera.",
   "question": false
  },
  {
   "n": 3,
   "t0": 8.68,
   "t1": 11.64,
   "from": 26,
   "to": 36,
   "text": "Por eso la ley limita cuánto peso puede llevar cada eje.",
   "question": false
  },
  {
   "n": 4,
   "t0": 11.96,
   "t1": 15.94,
   "from": 37,
   "to": 48,
   "text": "Entonces le pones más ejes, para repartir la carga entre más ruedas.",
   "question": false
  },
  {
   "n": 5,
   "t0": 16.36,
   "t1": 17.84,
   "from": 49,
   "to": 54,
   "text": "Pero cuando el camión va vacío,",
   "question": false
  },
  {
   "n": 6,
   "t0": 18.14,
   "t1": 23.68,
   "from": 55,
   "to": 70,
   "text": "esas ruedas de más sobran, se gastan, rozan contra el asfalto y hacen gastar más combustible.",
   "question": false
  },
  {
   "n": 7,
   "t0": 23.68,
   "t1": 30.02,
   "from": 71,
   "to": 93,
   "text": "Entonces ese eje lleva unos cojines de aire que lo suben cuando no hace falta y lo bajan cuando el camión va cargado.",
   "question": false
  },
  {
   "n": 8,
   "t0": 30.48,
   "t1": 31.92,
   "from": 94,
   "to": 98,
   "text": "Eso es el eje elevable.",
   "question": false
  },
  {
   "n": 9,
   "t0": 32.24,
   "t1": 33.3,
   "from": 99,
   "to": 103,
   "text": "Y tiene un premio extra.",
   "question": false
  },
  {
   "n": 10,
   "t0": 33.68,
   "t1": 37.42,
   "from": 104,
   "to": 117,
   "text": "En muchas autopistas, el peaje se cobra por cada eje que toca el suelo.",
   "question": false
  },
  {
   "n": 11,
   "t0": 37.74,
   "t1": 39.82,
   "from": 118,
   "to": 122,
   "text": "Rueda levantada, peaje más barato.",
   "question": false
  },
  {
   "n": 12,
   "t0": 40.04,
   "t1": 42.02,
   "from": 123,
   "to": 129,
   "text": "Así que esas ruedas no están rotas.",
   "question": false
  },
  {
   "n": 13,
   "t0": 42.24,
   "t1": 44.36,
   "from": 130,
   "to": 138,
   "text": "Suben y bajan según lo que lleva el camión.",
   "question": false
  }
 ],
