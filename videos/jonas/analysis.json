   "t1": 15.04,
   "from": 37,
   "to": 41,
   "text": "justo hacia el lado contrario.",
   "question": false
  },
  {
   "n": 6,
   "t0": 15.66,
   "t1": 20.9,
   "from": 42,
   "to": 55,
   "text": "Entonces vino una tormenta tan fuerte que los marineros pensaron que iban a morir.",
   "question": false
  },
  {
   "n": 7,
   "t0": 20.9,
   "t1": 26.84,
   "from": 56,
   "to": 71,
   "text": "Jonas sabía que era por su culpa, así que le pidió que lo lanzaran al mar.",
   "question": false
  },
  {
   "n": 8,
   "t0": 27.4,
   "t1": 30.16,
   "from": 72,
   "to": 81,
   "text": "Y en ese momento un gran pez se lo trago.",
   "question": false
  },
  {
   "n": 9,
   "t0": 30.58,
   "t1": 32.24,
   "from": 82,
   "to": 85,
   "text": "Allí, en la oscuridad,",
   "question": false
  },
  {
   "n": 10,
   "t0": 32.66,
   "t1": 35.1,
   "from": 86,
   "to": 91,
   "text": "Jonas oró y Dios lo escuchó.",
