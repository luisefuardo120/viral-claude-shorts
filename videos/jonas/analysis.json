  {
   "n": 1,
   "t0": 0,
   "t1": 4.34,
   "from": 0,
   "to": 10,
   "text": "Este hombre pasó tres días dentro de un pez y sobrevivió,",
   "question": false
  },
  {
   "n": 2,
   "t0": 4.76,
   "t1": 5.7,
   "from": 11,
   "to": 13,
   "text": "se llamaba Jonas.",
   "question": false
  },
  {
   "n": 3,
   "t0": 6.54,
   "t1": 10.26,
   "from": 14,
   "to": 27,
   "text": "Dios le pidió que fuera a la ciudad de Nínive a dar un mensaje,",
