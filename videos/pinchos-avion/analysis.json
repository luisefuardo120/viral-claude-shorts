{
 "duration": 50.26,
 "phrases": [
  {
   "n": 1,
   "t0": 0,
   "t1": 2.8,
   "from": 0,
   "to": 11,
   "text": "¿Para qué son esos pinchos que salen de las alas del avión?",
   "question": true
  },
  {
   "n": 2,
   "t0": 3.2,
   "t1": 5.3,
   "from": 12,
   "to": 20,
   "text": "Al volar, el avión se frota con el aire,",
   "question": false
  },
  {
   "n": 3,
   "t0": 5.62,
   "t1": 10.48,
   "from": 21,
   "to": 39,
   "text": "la lluvia y el hielo, y se va cargando de electricidad, como un globo que frotas con el pelo.",
   "question": false
  },
  {
   "n": 4,
   "t0": 10.84,
   "t1": 11.68,
   "from": 40,
   "to": 44,
   "text": "Pero está en el aire,",
   "question": false
  },
  {
   "n": 5,
   "t0": 12.04,
   "t1": 15.4,
   "from": 45,
   "to": 57,
   "text": "no toca el suelo, así que esa carga no tiene por dónde irse.",
   "question": false
  },
  {
   "n": 6,
   "t0": 15.88,
   "t1": 21.36,
   "from": 58,
   "to": 78,
   "text": "Y cuando por fin salta, lo hace a chispazos, que meten ruido en la radio y en los instrumentos de navegación.",
   "question": false
  },
  {
   "n": 7,
   "t0": 21.66,
   "t1": 25.24,
   "from": 79,
   "to": 93,
   "text": "Entonces le pones estas varillas en los bordes de las alas y de la cola.",
   "question": false
  },
  {
   "n": 8,
   "t0": 25.52,
   "t1": 31.54,
   "from": 94,
   "to": 113,
   "text": "Acaban en punta, y por una punta la electricidad se escapa mucho más fácil, poco a poco y sin chispazos.",
   "question": false
  },
  {
   "n": 9,
   "t0": 32.04,
   "t1": 35.92,
   "from": 114,
   "to": 125,
   "text": "Esos son los descargadores de estática, pero ojo, no son para rayos.",
   "question": false
  },
  {
   "n": 10,
   "t0": 36.26,
   "t1": 38.4,
   "from": 126,
   "to": 136,
   "text": "A un avión le cae de media un rayo al año,",
   "question": false
  },
  {
   "n": 11,
   "t0": 38.68,
   "t1": 39.34,
   "from": 137,
   "to": 140,
   "text": "y no pasa nada,",
   "question": false
  },
  {
   "n": 12,
   "t0": 39.68,
   "t1": 41.68,
   "from": 141,
   "to": 148,
   "text": "la electricidad corre por la piel de metal,",
   "question": false
  },
  {
   "n": 13,
   "t0": 41.96,
   "t1": 43.72,
   "from": 149,
   "to": 155,
   "text": "por fuera, y sale por otro punto,",
   "question": false
  },
  {
   "n": 14,
   "t0": 44.02,
   "t1": 47.58,
   "from": 156,
   "to": 169,
   "text": "así que esos pinchos están ahí para que el avión suelte, poco a poco,",
   "question": false
  },
  {
   "n": 15,
   "t0": 47.88,
   "t1": 49.84,
   "from": 170,
   "to": 176,
   "text": "la electricidad que va recogiendo del aire.",
   "question": false
  }
 ],
