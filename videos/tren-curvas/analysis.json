{
 "duration": 60.029,
 "phrases": [
  {
   "n": 1,
   "t0": 0,
   "t1": 3.18,
   "from": 0,
   "to": 11,
   "text": "Porque el tren no se sale en las curvas, sino tiene volante.",
   "question": false
  },
  {
   "n": 2,
   "t0": 3.52,
   "t1": 7.26,
   "from": 12,
   "to": 26,
   "text": "Sus dos ruedas van soldadas al mismo eje, así que giran siempre a la vez.",
   "question": false
  },
  {
   "n": 3,
   "t0": 7.58,
   "t1": 11.5,
   "from": 27,
   "to": 43,
   "text": "Pero en una curva, la rueda de fuera tiene que recorrer más camino que la de dentro.",
   "question": false
  },
  {
   "n": 4,
   "t0": 11.82,
   "t1": 15.32,
   "from": 44,
   "to": 53,
   "text": "Si fueran cilindros, una patinaría y chirriaría todo el tiempo.",
   "question": false
  },
  {
   "n": 5,
   "t0": 15.88,
   "t1": 18.9,
   "from": 54,
   "to": 64,
   "text": "Entonces las haces en forma de cono, más anchas por dentro.",
   "question": false
  },
  {
   "n": 6,
   "t0": 19.28,
   "t1": 20.84,
   "from": 65,
   "to": 73,
   "text": "En la curva el tren se va hacia fuera,",
   "question": false
  },
  {
   "n": 7,
   "t0": 21.16,
   "t1": 24.8,
   "from": 74,
   "to": 91,
   "text": "la rueda de fuera apoya en su parte más grande y la de dentro en la más pequeña.",
   "question": false
  },
  {
   "n": 8,
   "t0": 25.12,
   "t1": 27.66,
   "from": 92,
   "to": 101,
   "text": "Así, con la misma vuelta la de fuera avanza más.",
   "question": false
  },
  {
   "n": 9,
   "t0": 27.96,
   "t1": 30.3,
   "from": 102,
   "to": 110,
   "text": "Eso es la conicidad y el tren gira solo.",
   "question": false
  },
  {
   "n": 10,
   "t0": 30.72,
   "t1": 35.94,
   "from": 111,
   "to": 130,
   "text": "Pero en las rectas esos conos lo hacen bailar de lado a lado y a mucha velocidad ese baile crece.",
   "question": false
  },
  {
   "n": 11,
   "t0": 36.16,
   "t1": 40.68,
   "from": 131,
   "to": 145,
   "text": "Entonces le das muy poca inclinación al cono y pones amortiguadores que frenan el baile.",
   "question": false
  },
  {
   "n": 12,
   "t0": 40.94,
   "t1": 42.9,
   "from": 146,
   "to": 153,
   "text": "Pero en una curva cerrada eso no basta.",
   "question": false
  },
  {
   "n": 13,
   "t0": 43.12,
   "t1": 45.24,
   "from": 154,
   "to": 162,
   "text": "Así que cada rueda lleva un borde por dentro,",
   "question": false
  },
  {
   "n": 14,
   "t0": 45.54,
   "t1": 46.14,
   "from": 163,
   "to": 164,
   "text": "la pestaña,",
   "question": false
  },
  {
   "n": 15,
   "t0": 46.42,
   "t1": 48.48,
   "from": 165,
   "to": 172,
   "text": "que choca con el carril antes de salirse.",
   "question": false
  },
  {
   "n": 16,
   "t0": 48.96,
   "t1": 50.76,
   "from": 173,
   "to": 181,
   "text": "Y como en la curva todo empuja hacia fuera,",
   "question": false
  },
  {
   "n": 17,
   "t0": 51.2,
   "t1": 53.4,
   "from": 182,
   "to": 193,
   "text": "el carril de fuera se pone más alto que el de dentro.",
   "question": false
  },
  {
   "n": 18,
   "t0": 53.8,
   "t1": 54.84,
   "from": 194,
   "to": 197,
   "text": "Eso es el peralte.",
   "question": false
  },
  {
   "n": 19,
   "t0": 55.16,
   "t1": 59.66,
   "from": 198,
   "to": 215,
   "text": "Por eso el tren no se sale en las curvas, porque sus ruedas no son cilindros, son conos.",
   "question": false
  }
 ],
